{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "LS",
      "Bash(pwd)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(uv *)",
      "Bash(python -m pytest *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(mypy *)",
      "Bash(mkdir *)",
      "Bash(touch *)"
    ],
    "ask": [
      "Edit",
      "Write",
      "MultiEdit",
      "Bash(git commit *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(*/.env)",
      "Read(**/.env)",
      "Read(*id_rsa*)",
      "Read(*id_ed25519*)",
      "Bash(rm -rf *)",
      "Bash(curl * | sh)",
      "Bash(wget * | sh)",
      "Bash(git push *)",
      "Bash(git push --force *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-dangerous-bash.py",
            "args": []
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-sensitive-files.py",
            "args": []
          }
        ]
      }
    ]
  },
  "env": {
    "PYTHONUNBUFFERED": "1"
  }
}
